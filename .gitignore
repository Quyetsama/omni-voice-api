# ==========================================
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# ==========================================
# Saved Voices & Models (Giọng đã clone & Trọng số mô hình)
# Bỏ comment dòng dưới nếu bạn KHÔNG muốn đẩy giọng cá nhân lên Git:
saved_voices/*.pt
!saved_voices/.gitkeep

# Checkpoint / Trọng số mô hình nặng
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Ngoại lệ: giữ lại thư mục saved_voices
!saved_voices/

# ==========================================
# Environment & Secrets (Biến môi trường)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

